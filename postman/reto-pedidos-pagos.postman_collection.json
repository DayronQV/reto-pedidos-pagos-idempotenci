    {
      "name": "1. Flujo exitoso",
      "item": [
        {
          "name": "Crear pedido (aprobado)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"clave_caso1\", \"caso1-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 y pedido PAGADO\", () => {",
                  "  const j = pm.response.json();",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(j.estado).to.eql(\"PAGADO\");",
                  "  pm.expect(j.reserva.estado).to.eql(\"CONFIRMADA\");",
                  "  pm.expect(j.payment_key).to.eql(\"PAY-\" + pm.collectionVariables.get(\"clave_caso1\"));",
                  "  pm.expect(j.idempotente).to.eql(false);",
                  "});",
                  "pm.collectionVariables.set(\"pedido_id_caso1\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{clave_caso1}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{order_url}}/orders",
              "host": [
                "{{order_url}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_id\": 1,\n  \"cantidad\": 1,\n  \"simular_pago\": \"aprobado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Consultar el pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 y pedido PAGADO con reserva CONFIRMADA\", () => {",
                  "  const j = pm.response.json();",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(j.estado).to.eql(\"PAGADO\");",
                  "  pm.expect(j.reserva.estado).to.eql(\"CONFIRMADA\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{order_url}}/orders/{{pedido_id_caso1}}",
              "host": [
                "{{order_url}}"
              ],
              "path": [
                "orders",
                "{{pedido_id_caso1}}"
              ]
            }
          }
        },
        {
          "name": "Consultar el cobro en el mock",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 y cobro APROBADO\", () => {",
                  "  const j = pm.response.json();",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(j.estado).to.eql(\"APROBADO\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{payment_url}}/payments/PAY-{{clave_caso1}}",
              "host": [
                "{{payment_url}}"
              ],
              "path": [
                "payments",
                "PAY-{{clave_caso1}}"
              ]
            }
          }
        }
      ]
