          "name": "Clave A (queda 1 unidad)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"clave_caso5a\", \"caso5a-\" + Date.now());",
                  "pm.collectionVariables.set(\"clave_caso5b\", \"caso5b-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 y pedido PAGADO\", () => {",
                  "  const j = pm.response.json();",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(j.estado).to.eql(\"PAGADO\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{clave_caso5a}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{order_url}}/orders",
              "host": [
                "{{order_url}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_id\": 2,\n  \"cantidad\": 1,\n  \"simular_pago\": \"aprobado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Clave B (otra intención, sin stock)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"409 y pedido SIN_STOCK sin reserva\", () => {",
                  "  const j = pm.response.json();",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(j.estado).to.eql(\"SIN_STOCK\");",
                  "  pm.expect(j.reserva).to.eql(null);",
                  "  pm.expect(j.idempotente).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{clave_caso5b}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{order_url}}/orders",
              "host": [
                "{{order_url}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"producto_id\": 2,\n  \"cantidad\": 1,\n  \"simular_pago\": \"aprobado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Inventario final",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"El stock del producto 2 es 0, nunca negativo\", () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.find(p => p.id === 2).stock).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{order_url}}/products",
              "host": [
                "{{order_url}}"
              ],
              "path": [
                "products"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "order_url",
      "value": "http://127.0.0.1:5000"
